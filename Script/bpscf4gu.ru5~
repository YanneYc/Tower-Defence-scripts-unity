using System.Collections;
using UnityEngine;



    public class Spwaner : MonoBehaviour
    {
    public WaveInfo[] waveinfo;
    public static Spwaner instance;
    int currentWave;
    

    private void Awake()
    {
        if (instance != null) 
        {
            Destroy(this);
        }
        else 
        {
            instance = this;
            DontDestroyOnLoad(this);
        }
    }
    public void SpwanWave() 
    {
        StartCoroutine(Spwanning());
        currentWave++;
        if (currentWave >= waveinfo.Length)
        {
            currentWave = 0;
        }
    }
    IEnumerator Spwanning() 
    {
        for(int i = 0; i < waveinfo[currentWave].Count; i++) 
        {
            GameObject go = ObjectPool.instance.PullEnemes(waveinfo[currentWave].prefab.id);
            go.SetActive(true);

            yield return new WaitForSeconds(waveinfo[currentWave].Rate);
        }
       
    }
    }
